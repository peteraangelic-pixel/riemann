diff --git a/kaggriculture_meta_lab/experiments/c10_resource_efficiency/feed_guard.py b/kaggriculture_meta_lab/experiments/c10_resource_efficiency/feed_guard.py
new file mode 100644
index 0000000..78b19e0
--- /dev/null
+++ b/kaggriculture_meta_lab/experiments/c10_resource_efficiency/feed_guard.py
@@ -0,0 +1,86 @@
+"""C10 discovery candidate: preserve feed liquidity in the B21 day-0 round trips.
+
+This is NOT a promoted agent. It uses only its current observation and standard
+configuration, never opponent identity, replay ID, seed or future observations.
+No unit action changes; no additional purchases, stock reserve or routing.
+"""
+from __future__ import annotations
+
+import math
+
+
+def _get(config, name, default):
+    return config.get(name, default) if isinstance(config, dict) else getattr(config, name, default)
+
+
+def _wheat_price_upper(inventory):
+    # Default 1.32.7 curve. Ceil, rather than round, is conservative for a buy
+    # bound. Nondefault marketParams are explicitly excluded by the guard.
+    if inventory < 10000:
+        price = 25.0 + math.sqrt(10000 - inventory)
+    else:
+        price = 25.0 - (5.0 / math.log(401.0)) * math.log(1.0 + inventory - 10000)
+    return max(1, math.ceil(price))
+
+
+def decision(action, observation, configuration):
+    step = int(observation.get("step", 0))
+    if not 4 <= step <= 11 or int(_get(configuration, "turnsPerDay", 24)) != 24:
+        return None
+    if int(_get(configuration, "episodeSteps", 720)) != 720 or int(_get(configuration, "boardSize", 10)) != 10 or int(_get(configuration, "maxMarketOrdersPerTurn", 10)) < 2:
+        return None
+    if _get(configuration, "marketParams", None):
+        return None
+    orders = action.get("market", [])
+    if orders != [["SELL", "WHEAT", 1], ["BUY_PRODUCT", "WHEAT", 1]]:
+        return None
+    player = int(observation.get("player", 0))
+    farms = observation.get("farms") or []
+    private = observation.get("private") or {}
+    market = observation.get("market") or {}
+    if not 0 <= player < len(farms) or "WHEAT" not in market.get("inventory", {}) or "WHEAT" not in market.get("prices", {}):
+        return None
+    # Unit actions precede market orders. Ignore incoming deposits and subtract
+    # all submitted wheat pickup requests to obtain a conservative stock floor.
+    demand = 0
+    for op in [action.get("farmer", []), *action.get("hands", [])]:
+        if isinstance(op, list) and len(op) >= 2 and op[:2] == ["PICKUP", "WHEAT"]:
+            demand += max(0, int(op[2]) if len(op) > 2 else 1)
+    stock_floor = private.get("shed", {}).get("WHEAT", 0) - demand
+    if stock_floor < 1:
+        return None  # the pair may be a useful net purchase, not a round trip
+    capacity = int(_get(configuration, "shedCapacity", 100))
+    multiplier = int(_get(configuration, "farmHandCostMult", 1))
+    if capacity <= 0 or multiplier < 0:
+        return None
+    inventory = market["inventory"]["WHEAT"]
+    sell_quote = market["prices"]["WHEAT"]
+    cash = farms[player]["money"]
+    if sell_quote <= 1:
+        return None  # floor-price sales do not restore market inventory
+    # One opposing order can withdraw at most shedCapacity units. Our one-unit
+    # sell and subsequent one-unit buy cancel in the inventory bound.
+    buy_upper = _wheat_price_upper(inventory - capacity)
+    # B21 hires three helpers at the start of day 1: 1 + 1 + 2.
+    reserve = 4 * multiplier
+    floor_after_pair = cash + sell_quote - buy_upper
+    if floor_after_pair >= reserve:
+        return None
+    return {"step": step, "cash": cash, "stock_floor": stock_floor,
+            "sell_quote": sell_quote, "buy_upper": buy_upper,
+            "reserve": reserve, "worst_case_cash_after_pair": floor_after_pair}
+
+
+def patch_action(action, observation, configuration):
+    if decision(action, observation, configuration) is None:
+        return action
+    result = dict(action)
+    # Preserve order indices; do not slide an opponent's paired slot.
+    result["market"] = [["PASS"], ["PASS"]]
+    return result
+
+
+def wrap(base_policy, base_module=None):
+    def agent(observation, configuration):
+        return patch_action(base_policy(observation, configuration), observation, configuration)
+    return agent
