+#!/usr/bin/env python3
+"""Bounded C10 discovery: literal interpreter + read-only economic/action probes.
+
+No simulator rule is rewritten. Hooks call the original function exactly once,
+record before/after changes, and are removed after each episode.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter, defaultdict
+from contextlib import ExitStack
+import copy
+import hashlib
+import json
+from pathlib import Path
+import sys
+from unittest.mock import patch
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+PORT = ROOT / "kaggriculture_meta_lab/rust_port"
+sys.path.insert(0, str(PORT / "tools"))
+from export_tape import extract
+from py_reference import PythonReplay, SIM
+
+CASES = [("Ad Space Available", 106841276), ("Tarang222", 106846940), ("Matthew Huang", 106841278)]
+
+
+class Budget:
+    def __init__(self, path, limit=200):
+        self.path = Path(path)
+        self.data = json.loads(self.path.read_text()) if self.path.exists() else {"limit": limit, "runs": []}
+        if self.data["limit"] != limit:
+            raise ValueError("budget limit changed")
+
+    def reserve(self, **details):
+        if len(self.data["runs"]) >= self.data["limit"]:
+            raise RuntimeError("hard 200-game budget reached")
+        index = len(self.data["runs"])
+        self.data["runs"].append({**details, "status": "reserved"})
+        self.save()
+        return index
+
+    def complete(self, index, rewards):
+        self.data["runs"][index].update(status="completed", rewards=rewards)
+        self.save()
+
+    def save(self):
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = self.path.with_suffix(".tmp")
+        temporary.write_text(json.dumps(self.data, indent=2) + "\n")
+        temporary.replace(self.path)
+
+
+def remaining_plants(tape, turns=719):
+    result = []
+    for stream in tape:
+        suffix = [Counter() for _ in range(turns + 1)]
+        for step in reversed(range(turns)):
+            suffix[step] = suffix[step + 1].copy()
+            action = stream[min(step, len(stream) - 1)]
+            for op in [action.get("farmer", []), *action.get("hands", [])]:
+                if isinstance(op, list) and len(op) >= 2 and op[0] == "PLANT":
+                    suffix[step][op[1]] += 1
+        result.append(suffix)
+    return result
+
+
+def inventories(private):
+    out = Counter()
+    for inv in private["inventories"]:
+        out.update(inv)
+    return out
+
+
+class Observe:
+    def __init__(self, replay, suffix, own_seat):
+        self.replay, self.suffix, self.own = replay, suffix, own_seat
+        self.ids = {id(farm): i for i, farm in enumerate(replay.state[0].observation.farms)}
+        self.private_ids = {id(s.observation.private): i for i, s in enumerate(replay.state)}
+        self.ops = [defaultdict(lambda: Counter(attempts=0, changed=0, noop=0)) for _ in range(2)]
+        self.harvest = [Counter(), Counter()]
+        self.used = [Counter(), Counter()]
+        self.waste = [Counter(), Counter()]
+        self.deaths = [Counter(), Counter()]
+        self.ledger = [defaultdict(lambda: {"units": 0, "cash": 0, "min_price": None, "max_price": None}) for _ in range(2)]
+        self.fixed_cost = [Counter(), Counter()]
+        self.blocked_plants = [Counter(), Counter()]
+        self.seed_opportunities = []
+        self.fert_opportunities = []
+        self.days = []
+        self.events = []
+
+    def preturn(self, action):
+        step = self.replay.step
+        obs = self.replay.state[self.own].observation
+        farm = self.replay.state[0].observation.farms[self.own]
+        demand = Counter(op[1] for op in [action.get("farmer", []), *action.get("hands", [])]
+                         if isinstance(op, list) and len(op) >= 2 and op[0] == "PLANT")
+        for item, n in demand.items():
+            if n > obs.private["seeds"].get(item, 0):
+                self.blocked_plants[self.own][item] += n
+        for slot, order in enumerate(action.get("market", [])[:10]):
+            if len(order) >= 3 and order[0] == "BUY_SEED" and order[1] in SIM.CROPS:
+                item, qty = order[1], int(order[2])
+                future = self.suffix[self.own][step + 1].get(item, 0)
+                stock_floor = max(0, obs.private["seeds"].get(item, 0) - demand[item])
+                cap = min(qty, max(0, future - stock_floor))
+                if cap < qty:
+                    self.seed_opportunities.append({"step": step, "slot": slot, "crop": item, "requested": qty,
+                                                    "safe_cap": cap, "stock_floor": stock_floor, "remaining_requests": future})
+        for unit, (pos, inv, op) in enumerate(zip([farm["farmer"], *farm["hands"]], obs.private["inventories"],
+                                               [action.get("farmer", []), *action.get("hands", [])])):
+            tile = farm["tiles"][pos[1]][pos[0]]
+            if not isinstance(tile, dict) or tile.get("kind") != "PLANT" or inv.get("FERTILIZER", 0) <= 0:
+                continue
+            noop = op == ["PASS"] or (op == ["WATER"] and tile.get("watered_today"))
+            if noop and tile.get("fertilized_until_day", -1) < step // 24:
+                self.fert_opportunities.append({"step": step, "unit": unit, "crop": tile["crop"],
+                                               "yield": tile["yield_units"], "op": op})
+
+    def attach(self, stack):
+        original = SIM._apply_unit_action
+        def unit(farm, private, idx, action, *rest, **kwargs):
+            p = self.ids[id(farm)]
+            pos = SIM._farmer_position(farm, idx)
+            if pos is None:
+                return original(farm, private, idx, action, *rest, **kwargs)
+            x, y = pos
+            before = (tuple(pos), copy.deepcopy(farm["tiles"][y][x]), dict(private["inventories"][idx]), dict(private["shed"]), dict(private["seeds"]))
+            value = original(farm, private, idx, action, *rest, **kwargs)
+            after = (tuple(SIM._farmer_position(farm, idx)), farm["tiles"][y][x], private["inventories"][idx], private["shed"], private["seeds"])
+            name = str(action[0]) if action else "EMPTY"
+            stats = self.ops[p][name]
+            stats["attempts"] += 1
+            stats["changed" if before != after else "noop"] += 1
+            if p == self.own and name == "FEED" and isinstance(before[1], dict) and before[1].get("animal") and not before[1].get("fed_today") and before[2].get("WHEAT", 0) <= 0:
+                self.events.append({"event": "feed_without_wheat", "step": self.replay.step, "unit": idx, "position": [x,y], "animal": before[1]["animal"], "shed_wheat": before[3].get("WHEAT",0)})
+            if p == self.own and name == "PICKUP" and len(action) >= 2 and action[1] == "WHEAT" and SIM._is_shed_adjacent((x,y),10):
+                requested = int(action[2]) if len(action) > 2 else 1
+                received = after[2].get("WHEAT",0) - before[2].get("WHEAT",0)
+                if received < requested:
+                    self.events.append({"event": "short_wheat_pickup", "step": self.replay.step, "unit": idx, "position": [x,y], "requested": requested, "received": received, "shed_wheat": before[3].get("WHEAT",0)})
+            if name == "HARVEST":
+                for item, n in after[2].items():
+                    self.harvest[p][item] += max(0, n - before[2].get(item, 0))
+            if name in ("FEED", "FERTILIZE"):
+                for item, n in before[2].items():
+                    self.used[p][name + ":" + item] += max(0, n - after[2].get(item, 0))
+            if name == "DROP":
+                for item, n in before[2].items():
+                    self.waste[p][item] += max(0, n - after[2].get(item, 0) - (after[3].get(item, 0) - before[3].get(item, 0)))
+            return value
+        stack.enter_context(patch.object(SIM, "_apply_unit_action", unit))
+        commit = SIM._commit_unit
+        def transaction(op, item, price, farm, private, market, *args, **kwargs):
+            ok = commit(op, item, price, farm, private, market, *args, **kwargs)
+            if ok:
+                r = self.ledger[self.ids[id(farm)]][op + ":" + item]
+                r["units"] += 1; r["cash"] += price
+                r["min_price"] = price if r["min_price"] is None else min(price, r["min_price"])
+                r["max_price"] = price if r["max_price"] is None else max(price, r["max_price"])
+            return ok
+        stack.enter_context(patch.object(SIM, "_commit_unit", transaction))
+        for name, label in [("_do_hire", "HIRE"), ("_do_buy_land", "BUY_LAND")]:
+            fn = getattr(SIM, name)
+            def fixed(farm, *args, _fn=fn, _label=label, **kwargs):
+                before = farm["money"]
+                value = _fn(farm, *args, **kwargs)
+                self.fixed_cost[self.ids[id(farm)]][_label] += before - farm["money"]
+                return value
+            stack.enter_context(patch.object(SIM, name, fixed))
+        drop = SIM._drop_inventories_to_shed
+        def daily_drop(private, capacity):
+            before, shed = inventories(private), dict(private["shed"])
+            value = drop(private, capacity)
+            p = self.private_ids[id(private)]
+            for item, n in before.items():
+                self.waste[p][item] += max(0, n - (private["shed"].get(item, 0) - shed.get(item, 0)))
+            return value
+        stack.enter_context(patch.object(SIM, "_drop_inventories_to_shed", daily_drop))
+        for name, label in [("_daily_refresh_plants", "drought"), ("_daily_refresh_animals", "escape"), ("_decay_plants", "decay")]:
+            fn = getattr(SIM, name)
+            def refresh(farm, *args, _fn=fn, _label=label, **kwargs):
+                before = copy.deepcopy(farm["tiles"])
+                value = _fn(farm, *args, **kwargs)
+                for y, row in enumerate(before):
+                    for x, tile in enumerate(row):
+                        after = farm["tiles"][y][x]
+                        if not isinstance(tile, dict): continue
+                        crop = tile.get("crop") or tile.get("animal")
+                        if not crop: continue
+                        lost = not isinstance(after, dict) or (tile.get("kind") == "PLANT" and after.get("kind") != "PLANT") or (tile.get("animal") and not after.get("animal"))
+                        if _label == "decay" and tile.get("kind") == "PLANT":
+                            after_yield = after.get("yield_units", 0) if isinstance(after, dict) else 0
+                            self.deaths[self.ids[id(farm)]]["decayed_units:" + crop] += max(0, tile.get("yield_units", 0) - after_yield)
+                        if lost:
+                            self.deaths[self.ids[id(farm)]][_label + ":" + crop] += 1
+                            if self.ids[id(farm)] == self.own:
+                                self.events.append({"event": _label, "step": self.replay.step, "position": [x,y], "item": crop, "before": tile})
+                return value
+            stack.enter_context(patch.object(SIM, name, refresh))
+
+    def finish(self):
+        rows = []
+        for seat in (0, 1):
+            farm = self.replay.state[0].observation.farms[seat]
+            private = self.replay.state[seat].observation.private
+            sales = sum(v["cash"] for k,v in self.ledger[seat].items() if k.startswith("SELL:"))
+            buys = sum(v["cash"] for k,v in self.ledger[seat].items() if not k.startswith("SELL:"))
+            reconstructed = self.replay.env.configuration.startingMoney + sales - buys - sum(self.fixed_cost[seat].values())
+            assert reconstructed == farm["money"], (reconstructed, farm["money"])
+            rows.append({"seat": seat, "money": farm["money"], "ledger": dict(self.ledger[seat]),
+                         "fixed_cost": dict(self.fixed_cost[seat]), "harvested": dict(self.harvest[seat]),
+                         "consumed": dict(self.used[seat]), "shed_discarded": dict(self.waste[seat]),
+                         "deaths": dict(self.deaths[seat]), "operations": dict(self.ops[seat]),
+                         "end_seeds": private["seeds"], "end_shed": private["shed"],
+                         "end_carried": dict(inventories(private))})
+        return {"physical_seats": rows, "candidate_seat": self.own,
+                "seed_purchase_opportunities": self.seed_opportunities,
+                "zero_detour_fertilizer_opportunities": self.fert_opportunities, "events": self.events}
+
+
+def run_case(base, replay, team, own_seat, observer=False, policy=None):
+    opponent_seat = replay["info"]["TeamNames"].index(team)
+    stream = [frame[opponent_seat].get("action") or {} for frame in replay["steps"][1:]]
+    candidate = copy.deepcopy(base)
+    game = PythonReplay(candidate, [stream, stream], replay["info"]["seed"], steps=len(replay["steps"]),
+                        reverse=own_seat == 1, trim_hands=False, config=replay["configuration"])
+    watch = Observe(game, remaining_plants(base, game.turns), own_seat) if observer else None
+    with ExitStack() as stack:
+        if watch: watch.attach(stack)
+        while game.step < game.turns:
+            step = game.step
+            action = copy.deepcopy(base[own_seat][min(step, len(base[own_seat])-1)])
+            obs = dict(vars(game.state[own_seat].observation)); obs["step"] = step
+            action["hands"] = action.get("hands", [])[:len(obs["farms"][own_seat]["hands"])]
+            if watch: watch.preturn(action)
+            if policy is not None: action = policy(action, obs, game.env.configuration)
+            candidate[own_seat][min(step, len(candidate[own_seat])-1)] = action
+            game.advance()
+    return game.rewards(), watch.finish() if watch else None
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--slots", type=Path, required=True)
+    parser.add_argument("--baseline-report", type=Path, required=True)
+    parser.add_argument("--output", type=Path, default=HERE / "discovery.json")
+    parser.add_argument("--budget", type=Path, default=HERE / "budget.json")
+    args = parser.parse_args()
+    budget = Budget(args.budget)
+    expected = json.loads(args.baseline_report.read_text())["rows"]
+    base = extract()
+    rows = []
+    for slot in json.loads(args.slots.read_text()):
+        path = Path(slot["local_path"])
+        assert hashlib.sha256(path.read_bytes()).hexdigest() == slot["sha256"]
+        replay = json.loads(path.read_text())
+        if replay.get("module_version") != "1.32.7": raise ValueError("unvalidated engine version")
+        tapes = [[frame[p].get("action") or {} for frame in replay["steps"][1:]] for p in (0,1)]
+        ticket = budget.reserve(phase="original_replay", episode=slot["episode_id"], seed=replay["info"]["seed"])
+        original = PythonReplay(tapes, tapes, replay["info"]["seed"], steps=len(replay["steps"]), config=replay["configuration"]).run()
+        assert original == replay["rewards"], (original, replay["rewards"])
+        budget.complete(ticket, original)
+        for seat in (0,1):
+            ticket = budget.reserve(phase="b21_discovery", episode=slot["episode_id"], team=slot["team"], seed=replay["info"]["seed"], seat=seat)
+            rewards, trace = run_case(base, replay, slot["team"], seat, observer=True)
+            reference = next(r for r in expected if r["team"] == slot["team"] and r["episode_id"] == slot["episode_id"] and r["candidate_seat"] == seat)
+            assert rewards == [reference["self_reward"], reference["opp_reward"]], (rewards, reference)
+            budget.complete(ticket, rewards)
+            row = {"team": slot["team"], "episode": slot["episode_id"], "seed": replay["info"]["seed"], "seat": seat,
+                   "rewards": rewards, "margin": rewards[0]-rewards[1], "diagnostics": trace}
+            rows.append(row)
+            print(json.dumps({"team":slot["team"],"seat":seat,"rewards":rewards,"seed_caps":len(trace["seed_purchase_opportunities"]),"fert_slots":len(trace["zero_detour_fertilizer_opportunities"])}),flush=True)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps({"phase":"discovery","rows":rows,"budget_used":len(budget.data["runs"]),"candidate_frozen":False},indent=2)+'\n')
+
+
+if __name__ == "__main__":
+    main()
